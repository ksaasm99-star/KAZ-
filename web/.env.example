# KAZ محلي 100%. لا يحتاج أي مفتاح API.
KAZ_OWNER_TOKEN=change-me-to-a-random-string
KAZ_DEFAULT_PROVIDER=ollama
KAZ_API_ENABLED=false
KAZ_OLLAMA_HOST=http://127.0.0.1:11434

# إعدادات محلية اختيارية.
OLLAMA_MODEL=llama3.2
KAZ_LOCAL_MODEL_ID=kaz-local-general-small

# Optional / Advanced
# اختياري: تفعيل Gemini للمهام المتقدمة (معطل افتراضيًا)
# KAZ_ENABLE_GEMINI=false
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# KAZ_LLM_MODEL=gemini-2.5-flash
# OLLAMA_BASE_URL=http://127.0.0.1:11434
